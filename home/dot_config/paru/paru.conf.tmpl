# paru reads exactly ONE config file -- the first of $PARU_CONF,
# $XDG_CONFIG_HOME/paru/paru.conf, ~/.config/paru/paru.conf, /etc/paru.conf.
# it does NOT merge them. without the Include below, this file would silently
# drop everything /etc/paru.conf sets (Devel, Provides, PgpFetch,
# DevelSuffixes), which is a quiet behaviour change rather than an error.
#
# extending the system config this way is the idiom paru.conf(5) documents, and
# it keeps /etc/paru.conf pristine -- it's in paru's backup=(), so editing it
# there would mean a .pacnew to reconcile on every paru upgrade.
Include = /etc/paru.conf

[options]
# pop-launcher-git is a transitive dependency of
# gnome-shell-extension-pop-shell-git -- nothing declares it, so heptane never
# sees it and it can't simply be dropped.
#
# its PKGBUILD emits a malformed pkgver: "epoch.1.4.0.r0.ga332a3a". pacman's
# vercmp ranks a leading numeric segment above a leading alpha one, so
#   vercmp epoch.1.4.0.r0.ga332a3a-1 1.0.5.r0.geead361-1  ->  -1
# i.e. pacman genuinely believes the AUR's 1.0.5 is NEWER, and a plain -Syu
# "upgrades" the real software from 1.4.0 backwards to 1.0.5.
#
# there are two independent update paths and each needs its own switch:
#   - pkgver comparison  -> IgnorePkg in /etc/pacman.conf (verified: paru then
#     reports the package as "[ignored]")
#   - devel rebuild      -> this line. Devel is on system-wide, so paru also
#     rebuilds -git packages from git HEAD regardless of pkgver, and IgnorePkg
#     does not cover that (see IgnoreDevel in paru.conf(5)).
IgnoreDevel = pop-launcher-git

# local PKGBUILDs that mask their AUR namesakes -- see pkgbuilds/README.md in
# the chezmoi source dir. Path= (not Url=) so edits are picked up immediately
# with no review step; paru builds in place there.
[spladug]
Path = {{ dir .chezmoi.sourceDir }}/pkgbuilds
